    "tracking.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal Sort shows a few ads between levels. On the next screen you can allow ads that match your interests. Either way, the game works the same, and you can change this later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal Sort muestra algunos anuncios entre niveles. En la siguiente pantalla puedes permitir anuncios según tus intereses. Elijas lo que elijas, el juego funciona igual y puedes cambiarlo luego en Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal Sort seviyeler arasında az sayıda reklam gösterir. Sonraki ekranda ilgi alanlarına uygun reklamlara izin verebilirsin. Hangi seçimi yaparsan yap oyun aynı çalışır; bunu sonra Ayarlar'dan değiştirebilirsin."
          }
        }
      }
    },
